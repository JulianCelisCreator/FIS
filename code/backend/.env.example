# Copia este archivo como .env (git lo ignora) y ajusta lo que necesites.
# La API lo carga al arrancar y docker compose lo usa con --env-file .env.

# Puerto de la API
PORT=3000

# Base de datos (contenedor de db/compose.yaml). Si ya tienes un PostgreSQL
# local en el 5432, usa otro puerto, p. ej. 5433.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=patinaje
DB_USER=patinaje
DB_PASSWORD=patinaje_dev
