# Copia este archivo como .env (git lo ignora) y ajusta lo que necesites.
# La API lo carga al arrancar y docker compose lo usa con --env-file .env.

# Puerto de la API
PORT=3000

# Base de datos (contenedor de db/compose.yaml). Si ya tienes un PostgreSQL
# local en el 5432, usa otro puerto, p. ej. 5432.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=patinaje
DB_USER=patinaje
DB_PASSWORD=patinaje_dev

# Correo saliente (HU-M1-08, recuperación de contraseña). Sin RESEND_API_KEY no
# se envía nada: el correo (con el enlace) se escribe en la consola de la API.
# Con clave pero sin dominio verificado en Resend, solo llega al correo dueño
# de la cuenta de Resend. Nunca subas la clave al repositorio.
RESEND_API_KEY=
CORREO_REMITENTE=Velora <onboarding@resend.dev>

# Dirección de la aplicación, para armar los enlaces de los correos.
APP_URL=http://localhost:5173
